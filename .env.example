# Umgebungsvariablen für stack.yml (Portainer: "Environment variables")
APP_IMAGE=registry.example.com/youruser/kombi:1.0.0
APP_PORT=8000
APP_REPLICAS=1
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
APP_NAME=Kombi
BASE_URL=https://kombi.example.com
COOKIE_SECURE=true
SEED_DEMO=false
DB_PLACEMENT=node.hostname == mein-db-knoten
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=kombi@example.com
